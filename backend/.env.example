# Backend API Configuration

# Server
NODE_ENV=development
API_PORT=3000

# Blockchain Network
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
CHAIN_ID=421614

# Wallet (for transaction signing)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRIVATE_KEY=your_private_key_here

# Deployed Contracts
CREDIT_SCORE_REGISTRY=0x303521288Eb31C39c97CeDDb7aF1e593416EcAe8
STRATEGY_EXECUTOR=0x31986c5cb319b3519a863353b5d61eDC7327405c
FLASHBOTS_RELAYER=0xc80213B2920f20F8B0B2Dafd8D08703d0f23fbAE

# iExec Configuration
IEXEC_APP_ADDRESS=0x77978b4d66E473c804a891B9CfA2352f235af59C

# Gas Settings (optional - will use defaults)
MAX_GAS_PRICE_GWEI=50
GAS_MULTIPLIER=1.2

# Security
CORS_ORIGIN=http://localhost:3000
