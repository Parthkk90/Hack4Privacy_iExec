# Backend Configuration
PORT=3000
NODE_ENV=development
API_KEY=your_api_key_for_backend

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=421614
